<UserControl
    x:Class="TeknoParrotUi.UserControls.GameSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TeknoParrotUi.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TeknoParrotUi"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:TeknoParrotUi.Properties"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:viewModels="clr-namespace:TeknoParrotUi.ViewModels" xmlns:usercontrols="clr-namespace:TeknoParrotUi.UserControls"
    d:DesignHeight="706"
    d:DesignWidth="700"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="Inter, Microsoft YaHei UI, Microsoft JhengHei UI, sans-serif"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <system:Double x:Key="fieldHeight">28</system:Double>
        <viewModels:GameSettingsVisibilityConverter x:Key="gameSettingsVisibilityConverter" />
        <converters:StringToBoolConverter x:Key="stringToBoolConverter" />
        <converters:VirtualKeyToHexConverter x:Key="virtualKeyToHexConverter" />
        <Style x:Key="hintIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="teknoHint" TargetType="{x:Type ToolTip}">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Width" Value="350" />
            <Setter Property="Height" Value="auto" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="HorizontalOffset" Value="100px" />
            <Setter Property="VerticalOffset" Value="-20px" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border>
                            <Border.Background>
                                <SolidColorBrush Color="White" />
                            </Border.Background>
                            <StackPanel>
                                <TextBlock
                                    Margin="5"
                                    FontSize="18"
                                    FontStyle="Normal"
                                    FontWeight="UltraBold"
                                    Foreground="#FF000000"
                                    Text="TeknoHint"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="5"
                                    FontSize="18"
                                    Foreground="#FF000000"
                                    Text="{Binding Hint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock Height="{StaticResource fieldHeight}" Padding="2,4,2,2">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} - {1}">
                                            <Binding Path="CategoryName" />
                                            <Binding Path="FieldName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <materialDesign:PackIcon Kind="InformationOutline" Style="{StaticResource hintIcon}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10" />
            <ColumnDefinition />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="132*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="GameExecutableText"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,6,0,6"
            Text="{x:Static p:Resources.GameSettingsGameExecutable}"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="GamePathBox"
            Grid.Row="2"
            Grid.Column="1"
            Height="24"
            Margin="0,6,0,0"
            VerticalAlignment="Top"
            IsReadOnly="true"
            PreviewMouseDown="SelectExecutableForTextBox"
            Tag="SettingsTxt"
            Text="C:\Demo\Path\file.exe" />
        <TextBlock
            x:Name="GameExecutable2Text"
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,6,0,6"
            Text="{x:Static p:Resources.GameSettingsGameExecutable}"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="GamePathBox2"
            Grid.Row="4"
            Grid.Column="1"
            Height="24"
            Margin="0,6,0,0"
            VerticalAlignment="Top"
            IsReadOnly="true"
            PreviewMouseDown="SelectExecutable2ForTextBox"
            Tag="SettingsTxt"
            Text="C:\Demo\Path\file.exe" />

        <ScrollViewer
            Grid.Row="5"
            Grid.RowSpan="1"
            Grid.Column="1"
            Grid.ColumnSpan="1"
            Margin="0,10,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="GameSettingsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,0,5" VerticalAlignment="Top">
                                <TextBlock
                                    Padding="2,4,2,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} - {1}">
                                            <Binding Path="CategoryName" />
                                            <Binding Path="FieldName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock
                                    Padding="2,0,2,2"
                                    FontSize="11"
                                    FontWeight="Light"
                                    Foreground="{DynamicResource TeknoParrotHintForegroundBrush}"
                                    Text="{Binding Hint}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hint}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <ContentControl VerticalAlignment="Top">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FieldType}" Value="Text">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <TextBox
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Tag="SettingsTxt"
                                            Text="{Binding FieldValue, Mode=TwoWay}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding FieldType}" Value="Numeric">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <materialDesign:NumericUpDown
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            HorizontalContentAlignment="Left"
                                            Maximum="{Binding FieldMax}"
                                            Minimum="{Binding FieldMin}"
                                            Value="{Binding FieldValue, Mode=TwoWay}"
                                            ValueStep="1">
                                                            <materialDesign:NumericUpDown.ToolTip>
                                                                <ToolTip Style="{StaticResource teknoHint}" />
                                                            </materialDesign:NumericUpDown.ToolTip>
                                                        </materialDesign:NumericUpDown>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding FieldType}" Value="Bool">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <CheckBox
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            IsChecked="{Binding FieldValue, Mode=TwoWay, Converter={StaticResource stringToBoolConverter}}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding FieldType}" Value="Dropdown">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ComboBox
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            ItemsSource="{Binding FieldOptions, Mode=TwoWay}"
                                            SelectedValue="{Binding FieldValue, Mode=TwoWay}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding FieldType}" Value="DropdownIndex">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ComboBox
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            ItemsSource="{Binding FieldOptions, Mode=TwoWay}"
                                            SelectedValue="{Binding FieldValue, Mode=TwoWay}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding FieldType}" Value="Slider">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Slider
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            AutoToolTipPlacement="TopLeft"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding FieldMax, Mode=TwoWay}"
                                            Minimum="{Binding FieldMin, Mode=TwoWay}"
                                            Value="{Binding FieldValue, Mode=TwoWay, FallbackValue=0}">
                                                            <Slider.Style>
                                                                <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                                                    <Style.Triggers>
                                                                        <!-- When FieldStep is 0 or not set, hide ticks but keep normal keyboard behavior -->
                                                                        <DataTrigger Binding="{Binding FieldStep}" Value="0">
                                                                            <Setter Property="SmallChange" Value="1"/>
                                                                            <Setter Property="LargeChange" Value="1"/>
                                                                            <Setter Property="TickPlacement" Value="None"/>
                                                                            <Setter Property="TickFrequency" Value="1"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                    <!-- Default: when FieldStep > 0, use it for everything -->
                                                                    <Setter Property="SmallChange" Value="{Binding FieldStep, FallbackValue=1}"/>
                                                                    <Setter Property="LargeChange" Value="{Binding FieldStep, FallbackValue=1}"/>
                                                                    <Setter Property="TickFrequency" Value="{Binding FieldStep, FallbackValue=1}"/>
                                                                    <Setter Property="TickPlacement" Value="BottomRight"/>
                                                                </Style>
                                                            </Slider.Style>
                                                        </Slider>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="KeyCapture">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <usercontrols:KeyCaptureTextBox
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            Style="{DynamicResource MaterialDesignTextBox}"
                                            Tag="SettingsKeyCapture"
                                            VirtualKey="{Binding FieldValue, Mode=TwoWay, Converter={StaticResource virtualKeyToHexConverter}}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FieldType}" Value="MonitorSelection">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <usercontrols:MonitorSelection
                                            Height="{StaticResource fieldHeight}"
                                            Margin="0,0,0,5"
                                            SelectedMonitorIndex="{Binding FieldValue, Mode=TwoWay}"
                                            UseUnitySorting="{Binding UseUnitySorting}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </UniformGrid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid
            Grid.Row="6"
            Grid.Column="1"
            Grid.ColumnSpan="1"
            Height="49"
            VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="38*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Grid.RowSpan="2"
                Grid.Column="1"
                Height="Auto"
                MaxHeight="40"
                Margin="5"
                Click="BtnSaveSettings"
                Content="{x:Static p:Resources.SettingsSaveSettings}" />
            <Button
                Grid.RowSpan="2"
                Grid.Column="0"
                Height="Auto"
                MaxHeight="40"
                Margin="5"
                Click="BtnGoBack"
                Content="{x:Static p:Resources.Back}" />
        </Grid>
    </Grid>
</UserControl>

